# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If MONGODB_URI is left blank, SHEGUARD automatically utilizes an in-memory MongoDB instance for seamless local development
MONGODB_URI=

# Authentication Secret (Change in production)
JWT_SECRET=sheguard_secure_jwt_dev_secret_key_2026_xyz987

# SMS / Notification Service Providers (Optional for real SMS delivery in production)
# Supported providers: TWILIO, FAST2SMS, MSG91
SMS_PROVIDER=DEMO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# Public Base URL (Used for generating emergency tracking links)
PUBLIC_APP_URL=http://localhost:5173
